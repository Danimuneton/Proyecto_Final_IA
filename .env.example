# Copie este archivo como .env y ponga su llave. El archivo .env NO se sube a GitHub

# Opción por defecto: Groq (capa gratuita). Cree la llave en https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_su_llave_aqui
# LLM_MODEL=openai/gpt-oss-120b

# Alternativa 1: NVIDIA NIM (https://build.nvidia.com)
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.3-70b-instruct

# Alternativa 2: Ollama local (sin llave): instale Ollama y ejecute `ollama pull qwen2.5:7b`
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
